model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_store","dim_dept","dim_item","fct_sales","fct_forecast","stockout_runs"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table dim_date
ref table dim_store
ref table dim_dept
ref table dim_item
ref table fct_sales
ref table fct_forecast
ref table stockout_runs
ref table item_store_profile
ref table 'Service Level'
ref table 'Lead Time'

ref cultureInfo en-US

