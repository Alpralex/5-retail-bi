model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_store","dim_dept","dim_item","fct_sales","fct_forecast","stockout_runs"]

ref table dim_date
ref table dim_store
ref table dim_dept
ref table dim_item
ref table fct_sales
ref table fct_forecast
ref table stockout_runs
