table stockout_runs
	lineageTag: 093766c5-b2e4-4577-a146-4df6d66c4d94

	measure 'Est. Lost Revenue' = SUM ( stockout_runs[est_lost_revenue_usd] )
		formatString: \$#,0
		lineageTag: cd39925d-915e-49b5-828f-939164e1a704

	measure 'Stock-out Runs' = COUNTROWS ( stockout_runs )
		formatString: #,0
		lineageTag: 514c5d72-eaac-422d-b800-28dfce85276e

	measure 'Lost % of Revenue' = DIVIDE ( [Est. Lost Revenue], [Revenue Last 52 Weeks] )
		formatString: 0.0%
		lineageTag: 7af38471-d73f-4a60-8ce5-46a65578e91a

	column item_id
