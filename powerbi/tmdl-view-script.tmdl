createOrReplace

	/// Folder that holds the Parquet files, with a trailing backslash. Change it in Transform data > Manage parameters.
	expression DataFolder = "C:\\m5-retail-bi\\powerbi\\data\\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

		annotation PBI_ResultType = Text

	table dim_date
		dataCategory: Time

		column date_day
			dataType: dateTime
			isKey
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column week_start
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: week_start

		column month_start
			dataType: dateTime
			formatString: mmm yyyy
			summarizeBy: none
			sourceColumn: month_start

		column year_number
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year_number

		column month_number
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: month_number

		column weekday_name
			dataType: string
			summarizeBy: none
			sourceColumn: weekday_name

		column event_name
			dataType: string
			summarizeBy: none
			sourceColumn: event_name

		column event_type
			dataType: string
			summarizeBy: none
			sourceColumn: event_type

		partition dim_date = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_date.parquet" ) )
					in
						Source

	table dim_dept

		column dept_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: dept_id

		column category_name
			dataType: string
			summarizeBy: none
			sourceColumn: category_name

		partition dim_dept = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_dept.parquet" ) )
					in
						Source

	table dim_item

		column item_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: item_id

		column dept_id
			dataType: string
			summarizeBy: none
			sourceColumn: dept_id

		partition dim_item = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_item.parquet" ) )
					in
						Source

	table dim_store

		column store_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: store_id

		column state_id
			dataType: string
			summarizeBy: none
			sourceColumn: state_id

		column state_name
			dataType: string
			summarizeBy: none
			sourceColumn: state_name

		partition dim_store = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_store.parquet" ) )
					in
						Source

	table fct_forecast

		measure 'Actual Units' = SUM ( fct_forecast[actual_units] )
			formatString: #,0

		measure 'Forecast Units' = SUM ( fct_forecast[forecast_units] )
			formatString: #,0

		measure 'Forecast Bias %' = DIVIDE ( [Forecast Units] - [Actual Units], [Actual Units] )
			formatString: +0.0%;-0.0%;0.0%

		measure 'WAPE Item-Day %' =
				DIVIDE (
					SUMX ( fct_forecast, ABS ( fct_forecast[forecast_units] - fct_forecast[actual_units] ) ),
					[Actual Units]
				)
			formatString: 0.0%

		measure 'WAPE Store-Day %' =
				VAR StoreDays =
					SUMMARIZE ( fct_forecast, fct_forecast[date_day], fct_forecast[store_id] )
				VAR AbsError =
					SUMX ( StoreDays, ABS ( CALCULATE ( [Forecast Units] - [Actual Units] ) ) )
				RETURN
					DIVIDE ( AbsError, [Actual Units] )
			formatString: 0.0%

		column date_day
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column store_id
			dataType: string
			summarizeBy: none
			sourceColumn: store_id

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column actual_units
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: actual_units

		column forecast_units
			dataType: double
			formatString: #,0
			summarizeBy: sum
			sourceColumn: forecast_units

		partition fct_forecast = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_forecast.parquet" ) )
					in
						Source

	table fct_sales

		measure 'Revenue' = SUM ( fct_sales[revenue_usd] )
			formatString: \$#,0

		measure 'Units Sold' = SUM ( fct_sales[units] )
			formatString: #,0

		measure 'Revenue LY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )
			formatString: \$#,0

		measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue LY], [Revenue LY] )
			formatString: 0.0%

		measure 'Revenue Last 52 Weeks' =
				VAR LastDay = CALCULATE ( MAX ( fct_sales[date_day] ), ALL ( dim_date ) )
				RETURN
					CALCULATE ( [Revenue], DATESINPERIOD ( dim_date[date_day], LastDay, -364, DAY ) )
			formatString: \$#,0

		measure 'Revenue Prior 52 Weeks' =
				VAR LastDay = CALCULATE ( MAX ( fct_sales[date_day] ), ALL ( dim_date ) ) - 364
				RETURN
					CALCULATE ( [Revenue], DATESINPERIOD ( dim_date[date_day], LastDay, -364, DAY ) )
			formatString: \$#,0

		measure 'Revenue 52w YoY %' = DIVIDE ( [Revenue Last 52 Weeks] - [Revenue Prior 52 Weeks], [Revenue Prior 52 Weeks] )
			formatString: 0.0%

		column date_day
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column store_id
			dataType: string
			summarizeBy: none
			sourceColumn: store_id

		column dept_id
			dataType: string
			summarizeBy: none
			sourceColumn: dept_id

		column units
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: units

		column revenue_usd
			dataType: double
			formatString: \$#,0
			summarizeBy: sum
			sourceColumn: revenue_usd

		partition fct_sales = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_sales.parquet" ) )
					in
						Source

	table stockout_runs

		measure 'Est. Lost Revenue' = SUM ( stockout_runs[est_lost_revenue_usd] )
			formatString: \$#,0

		measure 'Stock-out Runs' = COUNTROWS ( stockout_runs )
			formatString: #,0

		measure 'Lost % of Revenue' = DIVIDE ( [Est. Lost Revenue], [Revenue Last 52 Weeks] )
			formatString: 0.0%

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column store_id
			dataType: string
			summarizeBy: none
			sourceColumn: store_id

		column run_start
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: run_start

		column run_end
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: run_end

		column run_days
			dataType: int64
			formatString: 0
			summarizeBy: sum
			sourceColumn: run_days

		column est_lost_units
			dataType: double
			formatString: #,0
			summarizeBy: sum
			sourceColumn: est_lost_units

		column est_lost_revenue_usd
			dataType: double
			formatString: \$#,0
			summarizeBy: sum
			sourceColumn: est_lost_revenue_usd

		partition stockout_runs = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "stockout_runs.parquet" ) )
					in
						Source

	relationship fct_sales_date
		fromColumn: fct_sales.date_day
		toColumn: dim_date.date_day

	relationship fct_sales_store
		fromColumn: fct_sales.store_id
		toColumn: dim_store.store_id

	relationship fct_sales_dept
		fromColumn: fct_sales.dept_id
		toColumn: dim_dept.dept_id

	relationship fct_forecast_date
		fromColumn: fct_forecast.date_day
		toColumn: dim_date.date_day

	relationship fct_forecast_store
		fromColumn: fct_forecast.store_id
		toColumn: dim_store.store_id

	relationship fct_forecast_item
		fromColumn: fct_forecast.item_id
		toColumn: dim_item.item_id

	relationship dim_item_dept
		fromColumn: dim_item.dept_id
		toColumn: dim_dept.dept_id

	relationship stockout_runs_item
		fromColumn: stockout_runs.item_id
		toColumn: dim_item.item_id

	relationship stockout_runs_store
		fromColumn: stockout_runs.store_id
		toColumn: dim_store.store_id

	relationship stockout_runs_date
		fromColumn: stockout_runs.run_start
		toColumn: dim_date.date_day
